{
  "name": "kiro",
  "version": "1.0.0",
  "description": "Kiro integration for the SDD Framework: conditional steering, lifecycle hooks, and a .kiro/specs symlink bridge. Optional; .sdd/ stays canonical.",
  "requires": {
    "framework": ">=2.0.0"
  },
  "install": {
    "opt_in": "setup.sh --profile <base>+kiro",
    "hint_when_detected": true
  },
  "detection": {
    "directories": [".kiro"],
    "executables": ["kiro"]
  },
  "features": {
    "steering": {
      "files": [
        {
          "source": "defaults/adapters/kiro/steering/sdd-framework.md",
          "destination": ".kiro/steering/sdd-framework.md"
        }
      ]
    },
    "hooks": {
      "files": [
        { "source": "defaults/adapters/kiro/hooks/sdd-hook-lib.sh", "destination": ".kiro/hooks/sdd-hook-lib.sh" },
        { "source": "defaults/adapters/kiro/hooks/sdd-pre-task.sh", "destination": ".kiro/hooks/sdd-pre-task.sh", "trigger": "PreTaskExec" },
        { "source": "defaults/adapters/kiro/hooks/sdd-post-task.sh", "destination": ".kiro/hooks/sdd-post-task.sh", "trigger": "PostTaskExec" },
        { "source": "defaults/adapters/kiro/hooks/sdd-stop.sh", "destination": ".kiro/hooks/sdd-stop.sh", "trigger": "Stop" },
        { "source": "defaults/adapters/kiro/hooks/sdd-pre-task.json", "destination": ".kiro/hooks/sdd-pre-task.json" },
        { "source": "defaults/adapters/kiro/hooks/sdd-post-task.json", "destination": ".kiro/hooks/sdd-post-task.json" },
        { "source": "defaults/adapters/kiro/hooks/sdd-stop.json", "destination": ".kiro/hooks/sdd-stop.json" }
      ]
    },
    "symlinks": {
      "pattern": ".kiro/specs/<phase> -> ../../.sdd/specs/active/<phase>",
      "created_by": ["setup.sh", "phase.sh new"],
      "removed_by": ["phase.sh archive"]
    }
  },
  "compatibility": {
    "os": ["darwin", "linux"],
    "notes": "Symlinks need Developer Mode or administrator rights on Windows. Where unavailable, .sdd/ is still complete."
  }
}
